# 复制为 .env 填值（.env 已被 gitignore，不会入库）。
# 本项目不引入 dotenv——启动前在 shell 里加载一次即可：
#   set -a; source .env; set +a
# 或者直接 export 单个变量。

# ============ AI 对话入口（可选） ============
# 不配任何东西时：装了 Claude Code 就走本机 CLI（订阅额度）；两者都没有则仅"AI 助手"不可用，
# 其余功能（浏览/Action/Function/审计/物化）完全正常。
# 配置 Anthropic API key 后，对话桥自动切换为在线 API 驱动：
ANTHROPIC_API_KEY=
# 显式指定驱动（可选）：api | claude-cli
#CHAT_DRIVER=
# api 驱动使用的模型（可选，默认 claude-opus-5）
#CHAT_MODEL=

# ============ 行情数据更新（可选） ============
# 仓库自带 2026-08-04 的真实科创板50 快照，不配这些也能完整运行。
# 引擎零联网——下面的变量不被引擎消费，只供"取数这一步"使用：
# 在 Claude 会话里让 AI 拉数落 CSV，或自写取数脚本生成同结构 CSV（列说明见 datasets/README.md）。

# 同花顺问财 OpenAPI
IWENCAI_BASE_URL=
IWENCAI_API_KEY=

# 东方财富数据渠道（如使用自备的东财数据服务/聚合接口）
EASTMONEY_BASE_URL=
EASTMONEY_API_KEY=
